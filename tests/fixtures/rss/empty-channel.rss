<?xml version="1.0" encoding="UTF-8"?>
<!--
  A valid RSS document carrying **zero** <item> elements.

  This is the case that must never be confused with a change signal. The feed was
  found, it parsed, and it holds nothing — which is a repair, not a quiet week —
  so it comes back as RssProblem.NO_ITEMS with ok=False. A change signal comes
  back ok=True with a populated liveness object, and the two are one boolean
  apart on purpose.
-->
<rss version="2.0">
  <channel>
    <title>Announcements</title>
    <link>https://example.test/feed/</link>
    <description>Nothing here yet.</description>
  </channel>
</rss>
