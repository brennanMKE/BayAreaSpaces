# Copy to .env and fill in. .env is gitignored; this file is committed.
#
# MAKER_CALENDAR_CONTACT is interpolated into the User-Agent in sources.yaml and
# is sent to every site we fetch. It is meant to be visible to site operators —
# it is how someone reaches you instead of blocking you. Keeping it out of git is
# about spam harvesting, not secrecy.
#
# Use the about page URL. No address is exposed anywhere: not in git, not in a
# request header, not in anyone's access logs. Adjust the path to whatever you
# actually publish.
MAKER_CALENDAR_CONTACT=https://brennan.sstools.co/maker-calendar
#
# THE PAGE MUST RESOLVE BEFORE THE FIRST RUN. A User-Agent pointing at a 404 is
# worse than no contact at all — it looks like a bot pretending to be
# accountable, and it undercuts the robots.txt position in CLAUDE.md. The page
# needs: what this bot is, which sources it fetches and how often, and a way to
# ask us to stop. Honor an opt-out immediately and without argument.

# Bookwhen public-feed token for Sequoia Fabrica. From Bookwhen admin ->
# "Calendar feeds". Account segment lcqebfpp6u7h is already in sources.yaml;
# only the token belongs here.
#SEQUOIA_FABRICA_BOOKWHEN_TOKEN=

# Postgres on EC2 — the published store. Do not fill in until the connection
# method, schema ownership and upsert semantics are settled (see CLAUDE.md).
#MAKER_CALENDAR_PG_DSN=
